# Copy this file to .env.local and adjust as needed.
# .env.local is gitignored, so it is safe for machine-specific values.

# Base path for API calls. Left as /api so the Vite dev proxy (see vite.config.ts)
# forwards requests to the FastAPI backend. In production this can be a full URL.
VITE_API_URL=/api

# When true, the UI uses scripted demo data (src/data/mockData.ts) instead of the
# backend, and shows a "Demo data" label. The demo data is NOT clinical output.
# Set to false once the backend is wired up.
VITE_USE_MOCK_DATA=true
